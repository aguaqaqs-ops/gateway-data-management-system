{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.fixture-oracle.golden-envelope.v1",
  "title": "Golden Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "golden_envelope_schema_version",
    "expectation_id",
    "kind",
    "contract_binding",
    "payload_descriptor",
    "content_digest",
    "payload"
  ],
  "properties": {
    "golden_envelope_schema_version": {
      "type": "integer",
      "const": 1
    },
    "expectation_id": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/lowerKebab"
    },
    "kind": {
      "type": "string",
      "enum": ["structured", "artifact", "recovery"]
    },
    "contract_binding": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/contractBinding"
    },
    "payload_descriptor": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/payloadDescriptor"
    },
    "content_digest": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/digestRef"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["storage", "value"],
          "properties": {
            "storage": {"const": "inline"},
            "value": {
              "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/jsonValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["storage", "value"],
          "properties": {
            "storage": {"const": "closure"},
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content_digest", "manifest"],
              "properties": {
                "content_digest": {
                  "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/digestRef"
                },
                "manifest": {
                  "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/jsonValue"
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "structured"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storage", "value"],
            "properties": {
              "storage": {"const": "inline"},
              "value": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/jsonValue"
              }
            }
          },
          "payload_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_type",
              "schema_id",
              "schema_version",
              "comparison_mode"
            ],
            "properties": {
              "media_type": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_id": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canonical_encoding_version": {"const": 1},
              "comparison_mode": {"const": "exact-canonical"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "recovery"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storage", "value"],
            "properties": {
              "storage": {"const": "inline"},
              "value": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/jsonValue"
              }
            }
          },
          "payload_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_type",
              "schema_id",
              "schema_version",
              "comparison_mode"
            ],
            "properties": {
              "media_type": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_id": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canonical_encoding_version": {"const": 1},
              "comparison_mode": {"const": "recovery-checkpoints"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "artifact"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storage", "value"],
            "properties": {
              "storage": {"const": "closure"},
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content_digest", "manifest"],
                "properties": {
                  "content_digest": {
                    "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/digestRef"
                  },
                  "manifest": {
                    "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/jsonValue"
                  }
                }
              }
            }
          },
          "payload_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_type",
              "schema_id",
              "schema_version",
              "comparison_mode"
            ],
            "properties": {
              "media_type": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_id": {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canonical_encoding_version": {"const": 1},
              "comparison_mode": {"const": "artifact-closure"}
            }
          }
        }
      }
    }
  ]
}
