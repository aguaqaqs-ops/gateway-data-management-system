{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.fixture-oracle.runner-result.v1",
  "title": "Runner Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runner_result_schema_version",
    "execution_key",
    "run_id",
    "contract_bindings",
    "status",
    "comparison_outcome",
    "expectations",
    "evidence_ref",
    "cleanup",
    "diagnostics"
  ],
  "properties": {
    "runner_result_schema_version": {
      "type": "integer",
      "const": 1
    },
    "execution_key": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/executionKey"
    },
    "run_id": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
    },
    "contract_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/manifestContractBinding"
      }
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "ASSERTION_FAILED", "HARNESS_ERROR", "UNSUPPORTED"]
    },
    "comparison_outcome": {
      "type": "string",
      "enum": ["NOT_RUN", "MATCH", "MISMATCH"]
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectation_id",
          "expected_content_digest",
          "actual_content_digest",
          "outcome"
        ],
        "properties": {
          "expectation_id": {
            "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/lowerKebab"
          },
          "expected_content_digest": {
            "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/digestRef"
          },
          "actual_content_digest": {
            "oneOf": [
              {"type": "null"},
              {
                "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/digestRef"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": ["NOT_RUN", "MATCH", "MISMATCH"]
          }
        }
      }
    },
    "evidence_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
        }
      ]
    },
    "cleanup": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/cleanupStatus"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASSED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "comparison_outcome": {"const": "MATCH"},
          "cleanup": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "CLEAN"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ASSERTION_FAILED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "comparison_outcome": {"const": "MISMATCH"},
          "cleanup": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "CLEAN"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "UNSUPPORTED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "comparison_outcome": {"const": "NOT_RUN"},
          "cleanup": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "CLEAN"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "HARNESS_ERROR"}}, "required": ["status"]},
      "then": {
        "properties": {
          "comparison_outcome": {
            "enum": ["NOT_RUN", "MATCH", "MISMATCH"]
          }
        }
      }
    }
  ]
}
