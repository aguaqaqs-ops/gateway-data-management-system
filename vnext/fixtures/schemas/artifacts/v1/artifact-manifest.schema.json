{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.artifacts.artifact-manifest.v1",
  "title": "ArtifactManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "logical_ref",
    "media_type",
    "size_bytes",
    "raw_sha256",
    "content_digest",
    "content_contract",
    "content_schema_id",
    "retention_class",
    "access_metadata",
    "content"
  ],
  "properties": {
    "manifest_schema_version": {
      "type": "integer",
      "const": 1
    },
    "logical_ref": {
      "$ref": "gateway-vnext.artifacts.definitions.v1#/$defs/logicalRef"
    },
    "media_type": {
      "type": "string",
      "const": "application/vnd.apache.arrow.stream"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "raw_sha256": {
      "$ref": "gateway-vnext.artifacts.definitions.v1#/$defs/digestRef"
    },
    "content_digest": {
      "$ref": "gateway-vnext.artifacts.definitions.v1#/$defs/digestRef"
    },
    "content_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "semantic_version"],
      "properties": {
        "contract_id": {
          "const": "gateway-vnext.canonical-row-hash-compute-boundary"
        },
        "semantic_version": {
          "const": "1.0.0"
        }
      }
    },
    "content_schema_id": {
      "const": "gateway-vnext.canonical-row-hash.canonical-row-hashes-artifact.v1"
    },
    "retention_class": {
      "$ref": "gateway-vnext.artifacts.definitions.v1#/$defs/retentionClass"
    },
    "access_metadata": {
      "$ref": "gateway-vnext.artifacts.definitions.v1#/$defs/accessMetadata"
    },
    "content": {
      "$ref": "gateway-vnext.artifacts.canonical-row-hashes-artifact.v1"
    }
  }
}
