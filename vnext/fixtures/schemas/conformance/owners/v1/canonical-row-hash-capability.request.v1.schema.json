{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.canonical-table-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_schema_version",
    "contract_binding",
    "canonical_encoding_version",
    "arrow_mapping_schema_version",
    "declared_table_schema"
  ],
  "properties": {
    "request_schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "semantic_version"],
      "properties": {
        "contract_id": {
          "type": "string",
          "const": "gateway-vnext.canonical-row-hash-compute-boundary"
        },
        "semantic_version": {
          "type": "string",
          "const": "1.0.0"
        }
      }
    },
    "canonical_encoding_version": {
      "type": "integer",
      "const": 1
    },
    "arrow_mapping_schema_version": {
      "type": "integer",
      "const": 1
    },
    "declared_table_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "nullable", "semantic_type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nullable": {
                "type": "boolean"
              },
              "semantic_type": {
                "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/declaredType"
              }
            },
            "if": {
              "properties": {
                "semantic_type": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "const": "null"
                    }
                  }
                }
              },
              "required": ["semantic_type"]
            },
            "then": {
              "properties": {
                "nullable": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
