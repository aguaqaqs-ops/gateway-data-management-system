{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.repository-service.stream-framing.v1",
  "title": "Repository Service Stream Framing v1",
  "description": "Binary wire framing contract snapshot for v1 streams.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framing_version",
    "frame_header_size_bytes",
    "frame_families",
    "control_json_max_bytes",
    "arrow_batch_max_bytes"
  ],
  "properties": {
    "framing_version": { "const": 1 },
    "frame_header_size_bytes": { "const": 6 },
    "frame_families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STREAM_HEADER", "ARROW_BATCH", "CHECKPOINT", "STREAM_END", "STREAM_ERROR"],
      "properties": {
        "STREAM_HEADER": { "const": 1 },
        "ARROW_BATCH": { "const": 2 },
        "CHECKPOINT": { "const": 3 },
        "STREAM_END": { "const": 4 },
        "STREAM_ERROR": { "const": 5 }
      }
    },
    "control_json_max_bytes": { "const": 1048576 },
    "arrow_batch_max_bytes": { "const": 67108864 }
  }
}
