{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.canonical-encoding.vector-set.v1",
  "title": "Canonical Encoding Vector Set Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set_schema_version",
    "vector_set_id",
    "owner",
    "contract_binding",
    "canonical_encoding_version",
    "files",
    "vector_set_content_digest"
  ],
  "properties": {
    "vector_set_schema_version": { "type": "integer", "const": 1 },
    "vector_set_id": {
      "type": "string",
      "const": "gateway-vnext.shared-kernel.canonical-encoding.v1"
    },
    "owner": { "type": "string", "const": "shared-kernel" },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "semantic_version"],
      "properties": {
        "contract_id": {
          "type": "string",
          "const": "gateway-vnext.shared-canonical-encoding"
        },
        "semantic_version": { "type": "string", "const": "1.0.0" }
      }
    },
    "canonical_encoding_version": { "type": "integer", "const": 1 },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "case_schema_id",
          "case_count",
          "size_bytes",
          "raw_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": ["digest.jsonl", "invalid.jsonl", "jcs.jsonl", "scalar.jsonl"]
          },
          "media_type": { "type": "string", "const": "application/x-ndjson" },
          "case_schema_id": {
            "type": "string",
            "enum": [
              "gateway-vnext.canonical-encoding.digest-case.v1",
              "gateway-vnext.canonical-encoding.invalid-case.v1",
              "gateway-vnext.canonical-encoding.jcs-case.v1",
              "gateway-vnext.canonical-encoding.scalar-case.v1"
            ]
          },
          "case_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "raw_sha256": {
            "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/digestRef"
          }
        }
      }
    },
    "vector_set_content_digest": {
      "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/digestRef"
    }
  }
}
