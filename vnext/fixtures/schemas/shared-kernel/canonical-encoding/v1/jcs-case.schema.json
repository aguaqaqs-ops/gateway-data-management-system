{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.canonical-encoding.jcs-case.v1",
  "title": "Canonical Encoding JCS Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_schema_version",
    "case_id",
    "operation",
    "input",
    "expected"
  ],
  "properties": {
    "case_schema_version": {
      "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/caseSchemaVersion"
    },
    "case_id": {
      "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/caseId"
    },
    "operation": { "const": "canonicalize-jcs" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_utf8_base64url"],
      "properties": {
        "json_utf8_base64url": {
          "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/base64url"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_bytes_base64url"],
      "properties": {
        "canonical_bytes_base64url": {
          "$ref": "gateway-vnext.canonical-encoding.definitions.v1#/$defs/base64url"
        }
      }
    }
  }
}
