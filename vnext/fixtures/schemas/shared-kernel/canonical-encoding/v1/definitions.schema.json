{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.canonical-encoding.definitions.v1",
  "title": "Canonical Encoding Shared Definitions v1",
  "description": "Test-only shared definitions for canonical-encoding normative vector schemas.",
  "$defs": {
    "caseSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "base64url": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        {
          "not": {
            "pattern": "^([A-Za-z0-9_-]{4})*[A-Za-z0-9_-]$"
          }
        }
      ]
    },
    "digestRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bitsHex8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "bitsHex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "integerBits": {
      "type": "integer",
      "enum": [8, 16, 24, 32, 64]
    },
    "stableErrorCode": {
      "type": "string",
      "enum": [
        "CANONICAL_INVALID_UTF8",
        "CANONICAL_INVALID_UNICODE",
        "CANONICAL_UNICODE_NONCHARACTER",
        "CANONICAL_JCS_SYNTAX_INVALID",
        "CANONICAL_JCS_DUPLICATE_MEMBER",
        "CANONICAL_JCS_NUMBER_OUT_OF_RANGE",
        "CANONICAL_JCS_NON_FINITE_NUMBER",
        "CANONICAL_IDENTIFIER_EMPTY",
        "CANONICAL_IDENTIFIER_COLLISION",
        "CANONICAL_TYPE_MISMATCH",
        "CANONICAL_INTEGER_OUT_OF_RANGE",
        "CANONICAL_DECIMAL_INVALID",
        "CANONICAL_FLOAT_NON_FINITE",
        "CANONICAL_TEMPORAL_INVALID",
        "CANONICAL_TIME_OUT_OF_RANGE",
        "CANONICAL_ANOMALY_INVALID",
        "CANONICAL_SCALAR_TAG_UNKNOWN",
        "CANONICAL_SCALAR_TAG_RESERVED",
        "CANONICAL_FRAME_TRUNCATED",
        "CANONICAL_ULEB128_NON_MINIMAL",
        "CANONICAL_ULEB128_OVERFLOW",
        "CANONICAL_FRAME_LENGTH_INVALID",
        "CANONICAL_COLLECTION_SEMANTICS_UNKNOWN",
        "CANONICAL_COLLECTION_DUPLICATE_ITEM",
        "CANONICAL_COLLECTION_DUPLICATE_KEY"
      ]
    },
    "expectedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/stableErrorCode" }
      }
    },
    "declaredType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null",
                "boolean",
                "float32",
                "float64",
                "string",
                "binary",
                "date",
                "datetime",
                "timestamp",
                "time-duration",
                "source-literal-anomaly"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bits"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["signed-integer", "unsigned-integer"]
            },
            "bits": { "$ref": "#/$defs/integerBits" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "precision", "scale"],
          "properties": {
            "kind": { "const": "decimal" },
            "precision": { "type": "integer", "minimum": 1, "maximum": 65 },
            "scale": { "type": "integer", "minimum": 0, "maximum": 30 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bit_width"],
          "properties": {
            "kind": { "const": "bit" },
            "bit_width": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      ]
    },
    "logicalLiteralSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "utf8-logical-literal" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bytes_base64url"],
          "properties": {
            "kind": { "const": "raw-logical-literal" },
            "bytes_base64url": { "$ref": "#/$defs/base64url" }
          }
        }
      ]
    },
    "typedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "null" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "decimal"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["signed-integer", "unsigned-integer", "decimal"]
            },
            "decimal": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bits_hex"],
          "properties": {
            "kind": { "const": "float32" },
            "bits_hex": { "$ref": "#/$defs/bitsHex8" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bits_hex"],
          "properties": {
            "kind": { "const": "float64" },
            "bits_hex": { "$ref": "#/$defs/bitsHex16" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["string", "date", "datetime", "timestamp", "time-duration"]
            },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bytes_base64url"],
          "properties": {
            "kind": { "type": "string", "enum": ["binary", "bit"] },
            "bytes_base64url": { "$ref": "#/$defs/base64url" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "envelope"],
          "properties": {
            "kind": { "const": "source-literal-anomaly" },
            "envelope": { "$ref": "#/$defs/anomalyEnvelope" }
          }
        }
      ]
    },
    "anomalyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_type",
        "raw_base64url",
        "raw_encoding",
        "reason"
      ],
      "properties": {
        "declared_type": { "$ref": "#/$defs/declaredType" },
        "raw_base64url": { "$ref": "#/$defs/base64url" },
        "raw_encoding": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "typedScalarInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_type", "typed_value"],
      "properties": {
        "declared_type": { "$ref": "#/$defs/declaredType" },
        "typed_value": { "$ref": "#/$defs/typedValue" }
      }
    },
    "digestKind": {
      "type": "string",
      "enum": [
        "row",
        "raw-content",
        "collection-item",
        "vector-set",
        "table-schema",
        "scenario-input",
        "scenario-fixture"
      ]
    },
    "collectionSemantics": {
      "type": "string",
      "enum": ["sequence", "multiset", "set", "keyed-collection"]
    }
  }
}
