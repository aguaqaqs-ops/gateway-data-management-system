{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.fixture-oracle.definitions.v1",
  "title": "Fixture Oracle Shared Definitions v1",
  "$defs": {
    "digestRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lowerKebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^(data|command|recovery)\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "track": {
      "type": "string",
      "enum": ["data", "command", "recovery"]
    },
    "subjectKind": {
      "type": "string",
      "enum": ["capability", "journey"]
    },
    "profileId": {
      "type": "string",
      "enum": ["integration", "process-crash", "provider-matrix", "reference"]
    },
    "legacyClassification": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "MATCH",
        "OLD_BUG",
        "NEW_BUG",
        "INTENTIONAL_CHANGE",
        "UNRESOLVED"
      ]
    },
    "posixRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\./)[^\\x00]+$"
    },
    "sharedAssetRef": {
      "type": "string",
      "pattern": "^sha256/[0-9a-f]{64}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "providerId": {
      "type": "string",
      "enum": ["python", "rust", "repository"]
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {"type": "string"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"$ref": "#/$defs/subjectKind"},
        "name": {"$ref": "#/$defs/lowerKebab"}
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "contract_id", "semantic_version"],
      "properties": {
        "owner": {"$ref": "#/$defs/lowerKebab"},
        "contract_id": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_version": {"$ref": "#/$defs/semver"},
        "wire_schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "manifestContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "owner", "contract_id", "semantic_version"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/lowerKebab"},
        "owner": {"$ref": "#/$defs/lowerKebab"},
        "contract_id": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_version": {"$ref": "#/$defs/semver"},
        "wire_schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "contentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_binding_id", "schema_id", "schema_version"],
      "properties": {
        "contract_binding_id": {"$ref": "#/$defs/lowerKebab"},
        "schema_id": {"$ref": "#/$defs/nonEmptyString"},
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_encoding_version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "provenanceHandcrafted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "HANDCRAFTED"}
      }
    },
    "provenanceSanitizedRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_reference",
        "sanitization_policy",
        "approval"
      ],
      "properties": {
        "kind": {"const": "SANITIZED_REGRESSION"},
        "source_reference": {"$ref": "#/$defs/nonEmptyString"},
        "sanitization_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id", "version"],
          "properties": {
            "policy_id": {"$ref": "#/$defs/lowerKebab"},
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "reference"],
          "properties": {
            "authority": {"$ref": "#/$defs/nonEmptyString"},
            "reference": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "provenance": {
      "oneOf": [
        {"$ref": "#/$defs/provenanceHandcrafted"},
        {"$ref": "#/$defs/provenanceSanitizedRegression"}
      ]
    },
    "inputAssetLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "path",
        "media_type",
        "size_bytes",
        "raw_sha256"
      ],
      "properties": {
        "logical_name": {"$ref": "#/$defs/lowerKebab"},
        "path": {"$ref": "#/$defs/posixRelativePath"},
        "media_type": {"$ref": "#/$defs/nonEmptyString"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_sha256": {"$ref": "#/$defs/digestRef"},
        "content_binding": {"$ref": "#/$defs/contentBinding"},
        "content_digest": {"$ref": "#/$defs/digestRef"}
      }
    },
    "inputAssetShared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "ref",
        "media_type",
        "size_bytes",
        "raw_sha256"
      ],
      "properties": {
        "logical_name": {"$ref": "#/$defs/lowerKebab"},
        "ref": {"$ref": "#/$defs/sharedAssetRef"},
        "media_type": {"$ref": "#/$defs/nonEmptyString"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_sha256": {"$ref": "#/$defs/digestRef"},
        "content_binding": {"$ref": "#/$defs/contentBinding"},
        "content_digest": {"$ref": "#/$defs/digestRef"}
      }
    },
    "inputAsset": {
      "oneOf": [
        {"$ref": "#/$defs/inputAssetLocal"},
        {"$ref": "#/$defs/inputAssetShared"}
      ]
    },
    "ownerClosureAssetLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "path",
        "media_type",
        "size_bytes",
        "raw_sha256"
      ],
      "properties": {
        "logical_name": {"$ref": "#/$defs/lowerKebab"},
        "path": {"$ref": "#/$defs/posixRelativePath"},
        "media_type": {"$ref": "#/$defs/nonEmptyString"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_sha256": {"$ref": "#/$defs/digestRef"}
      }
    },
    "ownerClosureAsset": {
      "oneOf": [
        {"$ref": "#/$defs/ownerClosureAssetLocal"}
      ]
    },
    "stimulusPayloadInline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "value"],
      "properties": {
        "storage": {"const": "inline"},
        "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "stimulusPayloadAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "logical_name"],
      "properties": {
        "storage": {"const": "asset-ref"},
        "logical_name": {"$ref": "#/$defs/lowerKebab"}
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_binding_id", "payload"],
      "properties": {
        "contract_binding_id": {"$ref": "#/$defs/lowerKebab"},
        "payload": {
          "oneOf": [
            {"$ref": "#/$defs/stimulusPayloadInline"},
            {"$ref": "#/$defs/stimulusPayloadAssetRef"}
          ]
        }
      }
    },
    "expectedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "kind",
        "path",
        "size_bytes",
        "raw_sha256",
        "contract_binding",
        "content_digest"
      ],
      "properties": {
        "expectation_id": {"$ref": "#/$defs/lowerKebab"},
        "kind": {
          "type": "string",
          "enum": ["structured", "artifact", "recovery"]
        },
        "path": {"$ref": "#/$defs/posixRelativePath"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_sha256": {"$ref": "#/$defs/digestRef"},
        "contract_binding": {"$ref": "#/$defs/contractBinding"},
        "content_digest": {"$ref": "#/$defs/digestRef"}
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_binding_id",
        "target",
        "boundary",
        "action",
        "occurrence"
      ],
      "properties": {
        "contract_binding_id": {"$ref": "#/$defs/lowerKebab"},
        "target": {"$ref": "#/$defs/lowerKebab"},
        "boundary": {"$ref": "#/$defs/lowerKebab"},
        "action": {"$ref": "#/$defs/lowerKebab"},
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      }
    },
    "recoveryTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_binding_id", "kind", "repetitions"],
      "properties": {
        "contract_binding_id": {"$ref": "#/$defs/lowerKebab"},
        "kind": {"$ref": "#/$defs/lowerKebab"},
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      }
    },
    "executionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "profile", "provider_id", "fixture_content_digest"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/scenarioId"},
        "profile": {"$ref": "#/$defs/profileId"},
        "provider_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/providerId"}
          ]
        },
        "fixture_content_digest": {"$ref": "#/$defs/digestRef"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"profile": {"const": "provider-matrix"}},
            "required": ["profile"]
          },
          "then": {"required": ["provider_id"], "properties": {"provider_id": {"$ref": "#/$defs/providerId"}}}
        },
        {
          "if": {
            "properties": {"profile": {"enum": ["integration", "process-crash", "reference"]}},
            "required": ["profile"]
          },
          "then": {"properties": {"provider_id": {"type": "null"}}}
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/lowerKebab"},
        "message": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "payloadDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "schema_id",
        "schema_version",
        "canonical_encoding_version",
        "comparison_mode"
      ],
      "properties": {
        "media_type": {"$ref": "#/$defs/nonEmptyString"},
        "schema_id": {"$ref": "#/$defs/nonEmptyString"},
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_encoding_version": {
          "type": "integer",
          "const": 1
        },
        "comparison_mode": {
          "type": "string",
          "enum": ["exact-canonical", "recovery-checkpoints", "artifact-closure"]
        }
      }
    },
    "verifiedAsset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "path", "media_type", "size_bytes", "raw_sha256"],
          "properties": {
            "logical_name": {"$ref": "#/$defs/lowerKebab"},
            "path": {"$ref": "#/$defs/posixRelativePath"},
            "media_type": {"$ref": "#/$defs/nonEmptyString"},
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "raw_sha256": {"$ref": "#/$defs/digestRef"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "ref", "media_type", "size_bytes", "raw_sha256"],
          "properties": {
            "logical_name": {"$ref": "#/$defs/lowerKebab"},
            "ref": {"$ref": "#/$defs/sharedAssetRef"},
            "media_type": {"$ref": "#/$defs/nonEmptyString"},
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "raw_sha256": {"$ref": "#/$defs/digestRef"}
          }
        }
      ]
    },
    "observationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "kind",
        "contract_binding",
        "payload_descriptor"
      ],
      "properties": {
        "expectation_id": {"$ref": "#/$defs/lowerKebab"},
        "kind": {
          "type": "string",
          "enum": ["structured", "artifact", "recovery"]
        },
        "contract_binding": {"$ref": "#/$defs/contractBinding"},
        "payload_descriptor": {"$ref": "#/$defs/payloadDescriptor"}
      }
    },
    "cleanupStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CLEAN", "LEAKED", "FAILED"]
        },
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      }
    }
  }
}
