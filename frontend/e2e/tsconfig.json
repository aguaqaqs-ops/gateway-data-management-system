{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "composite": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ]
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ]
}
