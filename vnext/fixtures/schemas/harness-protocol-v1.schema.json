{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.fixture-oracle.harness-protocol.v1",
  "title": "Harness Validated Plan DTO v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "harness_protocol_version",
    "execution_key",
    "run_id",
    "subject",
    "contract_bindings",
    "logical_time_start",
    "deterministic_seed",
    "verified_assets",
    "stimulus",
    "observation_requests"
  ],
  "properties": {
    "harness_protocol_version": {
      "type": "integer",
      "const": 1
    },
    "execution_key": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/executionKey"
    },
    "run_id": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
    },
    "subject": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/subject"
    },
    "contract_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/manifestContractBinding"
      }
    },
    "logical_time_start": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
    },
    "deterministic_seed": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/nonEmptyString"
    },
    "verified_assets": {
      "type": "array",
      "items": {
        "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/verifiedAsset"
      }
    },
    "stimulus": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/stimulus"
    },
    "fault": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/fault"
    },
    "recovery_trigger": {
      "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/recoveryTrigger"
    },
    "observation_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "gateway-vnext.fixture-oracle.definitions.v1#/$defs/observationRequest"
      }
    }
  },
  "not": {
    "anyOf": [
      {"required": ["expected_payload"]},
      {"required": ["golden_path"]},
      {"required": ["golden_digest"]},
      {"required": ["expected_content_digest"]}
    ]
  }
}
