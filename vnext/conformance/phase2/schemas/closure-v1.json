{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.phase2.closure.v1",
  "title": "Phase 2 Candidate Closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closure_schema_version",
    "candidate_revision",
    "candidate_identity",
    "environment_binding",
    "gate_attempts",
    "gate_summaries",
    "active_gate_requirements",
    "closure_status"
  ],
  "properties": {
    "closure_schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidate_revision": {
      "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/gitRevision"
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "worktree_status"],
      "properties": {
        "revision": {
          "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/gitRevision"
        },
        "worktree_status": {
          "type": "string",
          "enum": ["clean"]
        }
      }
    },
    "environment_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_digests"],
      "properties": {
        "lock_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {
                "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/posixRelativePath"
              },
              "digest": {
                "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/digestRef"
              }
            }
          }
        }
      }
    },
    "gate_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "gateway-vnext.phase2.gate-attempt.v1"
      }
    },
    "gate_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_name", "activation", "aggregate_status", "attempt_ids"],
        "properties": {
          "gate_name": {
            "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/gateName"
          },
          "activation": {
            "type": "string",
            "enum": ["active", "inactive", "external"]
          },
          "aggregate_status": {
            "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/gateStatus"
          },
          "attempt_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/attemptId"
            }
          }
        }
      }
    },
    "active_gate_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_name", "activation", "required_check_ids"],
        "properties": {
          "gate_name": {
            "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/gateName"
          },
          "activation": {
            "type": "string",
            "enum": ["active"]
          },
          "required_check_ids": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "$ref": "gateway-vnext.phase2.gate-attempt.v1#/$defs/checkId"
            }
          }
        }
      }
    },
    "closure_status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE"]
    }
  }
}
