    "caseSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "base64url": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        {
          "not": {
            "pattern": "^([A-Za-z0-9_-]{4})*[A-Za-z0-9_-]$"
          }
        }
      ]
    },
    "digestRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bitsHex8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "bitsHex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "integerBits": {
      "type": "integer",
      "enum": [
