{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-vnext.repository-service.stream-metadata.v1",
  "title": "Repository Service Stream Metadata v1",
  "description": "Control-frame metadata shapes for binary stream v1.",
  "$ref": "#/$defs/streamControlMetadataDocument",
  "$defs": {
    "storeKind": {
      "type": "string",
      "enum": ["VERSIONED", "CURRENT"]
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "cursorToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "tableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "At most 64 Unicode scalar values. UTF-8 byte length (max 256) is enforced by the Python validator."
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "emptyMetadata": {
      "type": "object",
      "additionalProperties": false
    },
    "versionedStreamHeaderMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_incarnation_id",
        "store_kind",
        "table_name",
        "declared_schema_digest",
        "query_options_digest",
        "snapshot_commit_id"
      ],
      "properties": {
        "repository_id": { "$ref": "#/$defs/uuidV7" },
        "repository_incarnation_id": { "$ref": "#/$defs/opaqueToken" },
        "store_kind": { "const": "VERSIONED" },
        "table_name": { "$ref": "#/$defs/tableName" },
        "declared_schema_digest": { "$ref": "#/$defs/sha256Hex" },
        "query_options_digest": { "$ref": "#/$defs/sha256Hex" },
        "snapshot_commit_id": { "$ref": "#/$defs/opaqueToken" }
      }
    },
    "currentStreamHeaderMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_incarnation_id",
        "store_kind",
        "table_name",
        "declared_schema_digest",
        "query_options_digest",
        "current_table_generation_id"
      ],
      "properties": {
        "repository_id": { "$ref": "#/$defs/uuidV7" },
        "repository_incarnation_id": { "$ref": "#/$defs/opaqueToken" },
        "store_kind": { "const": "CURRENT" },
        "table_name": { "$ref": "#/$defs/tableName" },
        "declared_schema_digest": { "$ref": "#/$defs/sha256Hex" },
        "query_options_digest": { "$ref": "#/$defs/sha256Hex" },
        "current_table_generation_id": { "$ref": "#/$defs/opaqueToken" }
      }
    },
    "streamHeaderMetadata": {
      "oneOf": [
        { "$ref": "#/$defs/versionedStreamHeaderMetadata" },
        { "$ref": "#/$defs/currentStreamHeaderMetadata" }
      ]
    },
    "streamCheckpointMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor_token"],
      "properties": {
        "cursor_token": { "$ref": "#/$defs/cursorToken" }
      }
    },
    "streamEndMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames_raw_sha256", "final_row_count"],
      "properties": {
        "frames_raw_sha256": { "$ref": "#/$defs/sha256Hex" },
        "final_row_count": { "type": "integer", "minimum": 0 }
      }
    },
    "streamErrorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code"],
      "properties": {
        "error_code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "streamControlMetadataDocument": {
      "oneOf": [
        { "$ref": "#/$defs/versionedStreamHeaderMetadata" },
        { "$ref": "#/$defs/currentStreamHeaderMetadata" },
        { "$ref": "#/$defs/streamCheckpointMetadata" },
        { "$ref": "#/$defs/streamEndMetadata" },
        { "$ref": "#/$defs/streamErrorMetadata" }
      ]
    },
    "streamFrameDocument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_version", "frame_family", "metadata"],
          "properties": {
            "frame_version": { "const": 1 },
            "frame_family": { "const": "STREAM_HEADER" },
            "metadata": { "$ref": "#/$defs/streamHeaderMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_version", "frame_family", "metadata", "payload_base64url"],
          "properties": {
            "frame_version": { "const": 1 },
            "frame_family": { "const": "ARROW_BATCH" },
            "metadata": { "$ref": "#/$defs/emptyMetadata" },
            "payload_base64url": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_version", "frame_family", "metadata"],
          "properties": {
            "frame_version": { "const": 1 },
            "frame_family": { "const": "CHECKPOINT" },
            "metadata": { "$ref": "#/$defs/streamCheckpointMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_version", "frame_family", "metadata"],
          "properties": {
            "frame_version": { "const": 1 },
            "frame_family": { "const": "STREAM_END" },
            "metadata": { "$ref": "#/$defs/streamEndMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_version", "frame_family", "metadata"],
          "properties": {
            "frame_version": { "const": 1 },
            "frame_family": { "const": "STREAM_ERROR" },
            "metadata": { "$ref": "#/$defs/streamErrorMetadata" }
          }
        }
      ]
    }
  }
}
