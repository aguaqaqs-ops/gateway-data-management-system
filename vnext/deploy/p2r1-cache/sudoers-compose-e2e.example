# Optional NOPASSWD rule for the P2-R4 S10 Compose import/restart gate only.
# Install with visudo after replacing <UV_BIN> and validating paths on the host:
#
#   sudo install -m 0440 sudoers-compose-e2e.example /etc/sudoers.d/gateway-compose-e2e
#   sudo visudo -cf /etc/sudoers.d/gateway-compose-e2e
#
# Verify without embedding a password in scripts or documentation:
#
#   sudo -n <UV_BIN> run pytest \
#     /home/tmpuser/gateway-data-management-system/vnext/repository_service/tests/test_import_compose_e2e.py::test_compose_repository_service_import_restart_replay \
#     -m serial -n 0 -v
#
# Do not broaden this rule beyond the single nodeid below.

tmpuser ALL=(root) NOPASSWD: <UV_BIN> run pytest /home/tmpuser/gateway-data-management-system/vnext/repository_service/tests/test_import_compose_e2e.py\:\:test_compose_repository_service_import_restart_replay -m serial -n 0 -v
